{
  "name": "anticipate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sim": "npm run build && npx cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'id=6AC482D9-4157-49B9-81E8-7830FFD2D798' -derivedDataPath /tmp/anticipate-build build && xcrun simctl boot 6AC482D9-4157-49B9-81E8-7830FFD2D798 2>/dev/null; open -a Simulator && xcrun simctl bootstatus 6AC482D9-4157-49B9-81E8-7830FFD2D798 -b && xcrun simctl install 6AC482D9-4157-49B9-81E8-7830FFD2D798 /tmp/anticipate-build/Build/Products/Debug-iphonesimulator/App.app && xcrun simctl launch 6AC482D9-4157-49B9-81E8-7830FFD2D798 com.akshath.anticipate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:ci": "vitest run",
    "preview": "vite preview",
    "seed": "node --experimental-strip-types scripts/seed-quizzes.ts",
    "seed:forum": "node --experimental-strip-types scripts/seed-forum.ts"
  },
  "dependencies": {
